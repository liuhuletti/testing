# Kopioi tämä .env-tiedostoksi: cp .env.example .env

# ── LLM-backend ────────────────────────────────────────────────────────────────
# Valitse jompikumpi: claude tai gemini
LLM_BACKEND=gemini            # claude | gemini

ANTHROPIC_API_KEY=sk-ant-...  # tarvitaan kun LLM_BACKEND=claude
GEMINI_API_KEY=               # tarvitaan kun LLM_BACKEND=gemini

ELEVENLABS_API_KEY=          # valinnainen, offline Piper on oletus

# Whisper-malli: tiny | base | small | medium | large-v3
WHISPER_MODEL=small

# TTS-backend: piper | elevenlabs
TTS_BACKEND=piper

# Piper-binäärin sijainti (Windows)
# PIPER_EXECUTABLE=C:/piper/piper.exe
# PIPER_MODEL=C:/piper/models/fi_FI-harri-medium.onnx

# ElevenLabs ääni-ID (jos TTS_BACKEND=elevenlabs)
# ELEVENLABS_VOICE_ID=...

# Wake word (tyhjä = ei wake wordia, kuunnellaan jatkuvasti)
WAKE_WORD=hei kaisa

# Loki
LOG_LEVEL=INFO
